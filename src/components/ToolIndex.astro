---
interface Props {
  headingId: string;
}

const { headingId } = Astro.props;

const tools = [
  {
    name: "Concrete Poetry",
    href: "/poetry",
    accent: "var(--color-red-std)",
  },
  {
    name: "Pomodoro",
    href: "/pomodoro",
    accent: "var(--color-blue-std)",
  },
];
---

<section class="tool-index" aria-labelledby={headingId}>
  <div class="tool-index__heading">
    <h2 id={headingId}>Tools</h2>
  </div>

  <div class="tool-index__list">
    {
      tools.map((tool) => (
        <a
          class="tool-index__link"
          href={tool.href}
          style={`--tool-accent: ${tool.accent}`}
        >
          <span class="tool-index__mark" aria-hidden="true" />
          <span class="tool-index__name">{tool.name}</span>
          <span class="tool-index__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .tool-index {
    width: clamp(13.5rem, 20vw, 19rem);
    color: var(--color-dark);
  }

  .tool-index__heading {
    padding-bottom: 0.38rem;
  }

  .tool-index__heading h2 {
    margin: 0;
    font-family: var(--font-pp-editorial);
    font-size: 1.12rem;
    font-weight: 800;
    line-height: 1;
  }

  .tool-index__list {
    border-top: 1px solid color-mix(in srgb, var(--color-dark) 56%, transparent);
  }

  .tool-index__link {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.35rem;
    padding: 0.26rem 0.12rem 0.26rem 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-dark) 32%, transparent);
    color: inherit;
    text-decoration: none;
    transition: color 100ms ease;
  }

  .tool-index__link:focus-visible {
    outline: 2px solid var(--tool-accent);
    outline-offset: 3px;
  }

  .tool-index__mark {
    width: 100%;
    height: 0.22rem;
    background: var(--tool-accent);
  }

  .tool-index__name {
    font-size: 1.08rem;
    font-weight: 400;
    line-height: 1.1;
    transition: color 100ms ease;
  }

  .tool-index__link:hover .tool-index__name {
    color: var(--tool-accent);
  }

  .tool-index__arrow {
    color: var(--tool-accent);
    font-family: var(--font-pp-editorial-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .tool-index {
      width: 100%;
      max-width: 20rem;
    }

    .tool-index__link {
      min-height: 2.2rem;
    }
  }
</style>
