---
import Header from "../components/Header.astro";
import KizakiLink from "../components/KizakiLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socials } from "../lib/links";
---

<BaseLayout>
  <Header />

  <div class="grain relative w-full h-screen overflow-hidden bg-light">
    <!-- Name -->
    <div
      class="absolute bottom-[30%] md:bottom-0 left-2 rotate-270 origin-top-left z-50"
    >
      <h2 class="text-h3 md:text-h2 italic font-ultralight">
        Joshua Motoaki Lau
      </h2>
    </div>

    <!-- Desktop -->
    <div
      class="hidden md:flex flex-col gap-2 absolute bottom-1/2 left-[20%] w-[40%] top-[30%] z-50"
    >
      <h3 class="text-h5">
        There is no reason not to consider the world as one gigantic painting.
      </h3>
      <div class="text-h6 text-dark-hover">- Robert Rauschenberg</div>
      <div class="flex-1 pt-6 flex flex-col items-end text-right">
        <h4 class="font-bold">Social Media</h4>
        {
          socials.map((link) => (
            <a
              class="nav-button"
              target="_blank"
              rel="noopener noreferrer"
              href={link.href}
            >
              {link.name}
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-xl">
        Making things at
        <KizakiLink />
      </p>
    </div>

    <!-- Mobile -->
    <p
      class="md:hidden absolute top-[10%] right-8 w-[50%] pt-36 text-xl z-50 pointer-events-none"
    >
      Making things at
      <KizakiLink class="pointer-events-auto" />
    </p>

    <div class="md:hidden absolute bottom-[5%] left-2 flex flex-col z-50">
      <h4 class="font-bold">Social Media</h4>
      {
        socials.map((link) => (
          <a
            class="nav-button"
            target="_blank"
            rel="noopener noreferrer"
            href={link.href}
          >
            {link.name}
          </a>
        ))
      }
    </div>

    <!-- Animated Color Bars -->
    <div class="absolute inset-0 z-10">
      <div
        class="bar bg-red-std top-[60%] md:top-[30%] [--bar-width:25%]"
        style="animation-delay: 0.25s;"
      >
        <span class="zh bar-char" style="animation-delay: 0.75s;"> 劉 </span>
      </div>
      <div
        class="bar bg-yellow-std top-[75%] md:top-[55%] [--bar-width:35%] md:[--bar-width:30%]"
        style="animation-delay: 0.5s;"
      >
        <span class="zh bar-char" style="animation-delay: 1s;"> 元 </span>
      </div>
      <div
        class="bar bg-orange-std top-[90%] md:top-[80%] [--bar-width:60%] md:[--bar-width:80%]"
        style="animation-delay: 0.75s;"
      >
        <span
          class="zh bar-char"
          style="animation-delay: 1.25s; animation-duration: 1.8s;"
        >
          明
        </span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .bar {
    position: absolute;
    right: 0;
    width: 0;
    height: 4rem;
    box-shadow:
      0 0 20px rgba(0, 0, 0, 0.1),
      inset 0 0 20px rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    animation: grow-bar 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .bar::before {
    content: "";
    position: absolute;
    inset: -2px;
    background: inherit;
    filter: blur(2px);
    opacity: 0.3;
    z-index: -1;
  }

  .bar-char {
    position: absolute;
    right: 0.2rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 5.5rem;
    font-weight: 600;
    opacity: 0;
    animation: fade-in-char 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @media (min-width: 768px) {
    .bar {
      height: 8rem;
    }

    .bar-char {
      right: 1rem;
      font-size: 11rem;
    }
  }

  @keyframes grow-bar {
    0% {
      width: 0;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    100% {
      width: var(--bar-width);
      opacity: 1;
    }
  }

  @keyframes fade-in-char {
    0% {
      opacity: 0;
      transform: translateY(-50%) scale(0.8);
    }
    100% {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }
</style>
