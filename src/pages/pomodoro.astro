---
import SettingsDialog from "../components/pomodoro/SettingsDialog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { MODES } from "../lib/pomodoro/modes";
import "../styles/pomodoro.css";
---

<BaseLayout title="Pomodoro">
  <div
    id="timer-bg"
    class="grain grain-color relative w-full h-screen overflow-hidden bg-red-std transition-colors duration-300 [--grain-opacity:0.2]"
  >
    <main
      class="bg-dark/10 w-full h-full flex items-center justify-center p-4 md:p-16"
    >
      <div
        class="bg-dark text-light w-full h-full flex flex-col items-center justify-center gap-4"
      >
        <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-8">
          {
            MODES.map((mode) => (
              <button class="pomo-btn" type="button" data-mode={mode.id}>
                {mode.label}
              </button>
            ))
          }
        </div>

        <div
          id="timer-display"
          class="text-huge font-light tabular-nums min-w-[300px] text-center"
        >
          25:00
        </div>

        <div class="grid grid-cols-2 gap-2 md:flex md:gap-4 mt-8">
          <button class="pomo-btn" type="button" id="start-stop-btn">
            Start
          </button>
          <button class="pomo-btn" type="button" id="reset-btn">Reset</button>
          <button class="pomo-btn" type="button" id="add-5-btn">+5 min</button>
          <button class="pomo-btn" type="button" id="settings-btn">
            Settings
          </button>
        </div>

        <h1
          class="absolute top-4 left-4 text-h2 md:text-huge italic font-bold text-outline"
        >
          Pomodoro
        </h1>
        <p class="absolute bottom-4 right-4 md:text-h6 text-outline">
          Built by
          <a href="/" class="underline"> Joshua Motoaki Lau </a>
        </p>
      </div>
    </main>
  </div>

  <SettingsDialog />

  <div id="reset-dialog" class="pomo-dialog" data-dialog>
    <div class="pomo-dialog-content small">
      <h3 class="text-h4 mb-4">Reset Timer?</h3>
      <p class="mb-6">Are you sure you want to reset the current timer?</p>
      <div class="flex gap-4 justify-center">
        <button class="pomo-btn-solid" type="button" id="confirm-reset">
          Reset
        </button>
        <button class="pomo-btn-ghost" type="button" data-dialog-close>
          Cancel
        </button>
      </div>
    </div>
  </div>

  <script>
    import { PomodoroTimer } from "../lib/pomodoro/timer";

    new PomodoroTimer().init();
  </script>
</BaseLayout>
